# Backend API base URL.
VITE_API_URL="http://localhost:4000"

# Firebase web-app config (Project settings > General > Your apps).
# These are public identifiers — safe to expose in the client bundle.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="<project-id>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<project-id>"
VITE_FIREBASE_STORAGE_BUCKET="<project-id>.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="<sender-id>"
VITE_FIREBASE_APP_ID="<web-app-id>"

# Web Push certificate key pair (Project settings > Cloud Messaging).
VITE_FIREBASE_VAPID_KEY="<public-vapid-key>"

# Escalation window shown in the countdown pill. Must match the backend's
# ESCALATION_DELAY_MS (60000 ms = 60 s).
VITE_ESCALATION_WINDOW_S=60

# Debug-only header counter: pending alerts past the window with no worker
# confirmation. Leave "false" outside a dry run.
VITE_DEBUG_ESCALATION="false"
