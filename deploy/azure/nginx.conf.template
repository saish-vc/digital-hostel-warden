map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map "$request_method:$http_authorization:$http_accept" $spa_navigation {
    default 0;
    ~*^GET::.*text/html 1;
}

resolver 127.0.0.11 valid=10s ipv6=off;
upstream backend {
    zone backend 64k;
    server api:3001 resolve;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location = /nginx-health {
        access_log off;
        return 200 'ok';
    }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    # Express routes are case-insensitive by default; also deny nested paths.
    location ~* ^/(?:api/)*(?:internal|loadtest|metrics)(?:/|$) {
        return 404;
    }

    location /api/ {
        proxy_pass http://backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Browser navigation and root-level mobile API routes share these paths.
    location ~ ^/(?:leaves/?|alerts/[A-Za-z0-9-]+/?)$ {
        error_page 418 = @root_api;
        if ($spa_navigation = 0) { return 418; }
        try_files /index.html =404;
    }
    location @root_api {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(auth|alerts|wardens|health|leave|leaves)(/|$) {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
