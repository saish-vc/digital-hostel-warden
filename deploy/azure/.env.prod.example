# Copy to the repository root as .env.prod; chmod 600 .env.prod.
# Replace all required placeholders. Never commit real credentials.
# Generate independent URL-safe secrets with: openssl rand -hex 32
# Hex avoids URL encoding issues in the Postgres and Redis connection URLs.
DOMAIN=replace-with-public-domain
POSTGRES_PASSWORD=replace-with-long-random-hex
REDIS_PASSWORD=replace-with-long-random-hex
# Required: fill with one distinct value, e.g. openssl rand -hex 32
JWT_SECRET=
# Required on both API and worker for the internal relay, even without monitoring.
# Fill with a second distinct value.
METRICS_TOKEN=
CORS_ORIGIN=https://replace-with-public-domain

# Compose derives the dashboard REST URL from DOMAIN and passes it at build time.
# Firebase web identifiers below are public build arguments, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional: base64 of the Firebase service-account JSON, on one line.
# Blank disables server-side push notifications.
FIREBASE_SERVICE_ACCOUNT_B64=

# Optional Twilio SMS fallback; all four values are needed to send SMS.
# Blank credentials disable successful SMS escalation, not the API.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WARDEN_ONCALL_PHONE=
