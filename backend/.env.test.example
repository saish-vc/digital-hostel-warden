# Copy to backend/.env.test (it is gitignored) and adjust if your local
# Postgres/Redis use different credentials or ports.
#
# The tests read ONLY the TEST_* variables below, then map them onto
# DATABASE_URL / REDIS_URL / DIRECT_DATABASE_URL for the app. Anything not
# defined here falls back to safe test defaults in tests/helpers/testEnv.ts.
#
# Start the containers with:  npm run test:db:up
# Stop and wipe them with:    npm run test:db:down

# Separate DATABASE, same server. The name MUST end in _test; the suite
# refuses to run otherwise so it can never truncate your dev database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostel_emergency_test?schema=public"

# DIRECT_DATABASE_URL is FORCED to TEST_DATABASE_URL by
# tests/helpers/testEnv.ts (schema.prisma uses it for `prisma migrate`), so
# you never need to set it for tests. Never point a test run at a real direct
# database URL.

# Separate Redis DB index (1), same server. Index 0 is refused: the suite
# flushes this database before every file and must never touch dev data.
TEST_REDIS_URL="redis://localhost:6379/1"

# Test-only signing secret. Never reuse the dev or production secret.
JWT_SECRET="test-only-jwt-secret-do-not-use-outside-tests"

# Escalation tests wait on this delay. Keep it small or the suite blows its
# 90s budget; the tests also assert this value is <= 2000.
ESCALATION_DELAY_MS=500

# Fake Twilio credentials — the SDK is always mocked in tests, but the SMS
# service validates that these are present and that the phone is E.164.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID="ACtest00000000000000000000000000"
TWILIO_AUTH_TOKEN="test-auth-token"
TWILIO_FROM_NUMBER="+15005550006"
WARDEN_ONCALL_PHONE="+15005550007"

# Left empty on purpose: push tests mock firebase-admin, everything else
# exercises the "push disabled" path.
FIREBASE_SERVICE_ACCOUNT_B64=""
DASHBOARD_URL=""
