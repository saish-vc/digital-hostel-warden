[TEMPLATE]
# =============================================================================
# DATABASE — pooled (app) + direct (migrations)
# =============================================================================
# DATABASE_URL is what every app instance uses. It MUST point at the pooled
# endpoint (PgBouncer / Neon pooler / Railway internal proxy), not directly at
# Postgres: each Prisma client opens a pool of ~17 connections by default, so
# 3 API instances would consume ~51 Postgres connections before any traffic.
#
# The parameters:
#   ?pgbouncer=true      tells Prisma it is talking to PgBouncer in
#                        TRANSACTION mode, so it disables prepared-statement
#                        caching (transaction pooling cannot keep server-side
#                        prepared statements per client).
#   &connection_limit=5  caps the Prisma client's own pool at 5. 3 instances
#                        x 5 = 15 app connections through PgBouncer, which
#                        then multiplexes them onto a handful of Postgres
#                        backends.
#
# Local (no PgBouncer):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostel_emergency?schema=public"
#
# Neon (pooled hostname ends in -pooler; use the SAME host for directUrl but
# WITHOUT the -pooler suffix):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/hostel_emergency?sslmode=require&pgbouncer=true&connection_limit=5"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/hostel_emergency?sslmode=require"
#
# Railway: the dashboard-injected DATABASE_URL is already the pooled
# internal/proxy URL. Paste it verbatim into DATABASE_URL. For migrations,
# use the direct/public connection string (Railway: Postgres service ->
# Connect -> "Public Networking" URL) as DIRECT_DATABASE_URL.
#
# DIRECT_DATABASE_URL is used ONLY by `prisma migrate` / `prisma db pull`
# (schema.prisma: directUrl). PgBouncer in transaction mode cannot run
# migrations: DDL needs a session-scoped connection, advisory locks and
# prepared statements. Keep it direct.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostel_emergency?schema=public"

# Signing secret for access tokens. Use a long random string outside local dev.
# JWTs are stateless — there is NO session store by design; the Redis instance
# is for the Socket.IO adapter and BullMQ only.
JWT_SECRET="dev-only-secret-change-me-please-32-chars-minimum"

# Token lifetime (optional, defaults to 7d).
JWT_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# HTTP / instance identity
# -----------------------------------------------------------------------------
# Leave PORT unset under PM2: each cluster worker derives its port from
# NODE_APP_INSTANCE as 3001 + index (see src/config/instance.ts).
# Set PORT explicitly for Railway/Render services and local multi-instance
# terminals (`PORT=3001 npm run dev`).
# PORT=4000

# PM2 sets NODE_APP_INSTANCE automatically in cluster mode (0, 1, 2...).
# You normally do not set this yourself. If NODE_APP_INSTANCE=0 the API
# listens on 3001; 1 -> 3002; 2 -> 3003.
# NODE_APP_INSTANCE=0

# Origin allowed by CORS (the Vite dev server, or the nginx origin in prod).
CORS_ORIGIN="http://localhost:5173"

# Set to "true" in production behind a TLS terminator (nginx, cloud LB, Vercel).
# Set to "false" when running behind no TLS terminator (local dry runs, demo rehearsals).
# Default when unset: true if NODE_ENV=production, false otherwise.
ENABLE_HTTPS_REDIRECT=false

# Base64-encoded service-account JSON for Firebase Admin (FCM push).
# Generate with:
#   macOS/Linux:  base64 -i service-account.json | tr -d '\n'
#   Windows:      [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Optional — if unset, the API runs normally with push disabled.
FIREBASE_SERVICE_ACCOUNT_B64=""

# Public https base URL of the warden dashboard, used as the FCM click link
# and the dashboard link in escalation SMS. Optional.
DASHBOARD_URL=""

# =============================================================================
# REDIS
# =============================================================================
# Shared by all API instances and the worker. The Redis Socket.IO adapter
# (pub/sub) and BullMQ both use this URL but each opens its OWN connection:
#   - BullMQ Queue (API) + BullMQ Worker (worker process)
#   - adapter PUB (API)
#   - adapter SUB (API, duplicate())
#   - /health ping (API, lazy)
# Never point these at the same ioredis client in code — see
# src/config/redis.ts for the connection budget.
#
# Apply `maxmemory-policy noeviction` and AOF `everysec` to this Redis in
# production: evicting queue keys silently drops escalations.
#
# Local dev (docker run -d --name hostel-redis -p 6379:6379 redis:7-alpine):
REDIS_URL="redis://localhost:6379"
# Railway / Render: they hand you a redis:// URL — paste it verbatim.
# Upstash: TLS endpoint, scheme is rediss:// (note the double s), e.g.
#   REDIS_URL="rediss://default:xxxxx@your-db.upstash.io:6379"
# ioredis enables TLS automatically from the rediss:// scheme.

# Escalation delay override (ms). Default 60000 = 60s. Lower ONLY for tests
# (e.g. 3000 to exercise the acknowledge-vs-SMS race).
ESCALATION_DELAY_MS=60000

# Base URL the ESCALATION WORKER posts the real SMS outcome to, so the
# dashboard's escalation pill reports delivery truth instead of a 60s client
# guess. Point at any API instance; the Redis adapter fans it out to all three.
# Authenticated with METRICS_TOKEN via the x-internal-token header.
# Leave UNSET to disable the relay (unit tests drive the processor directly).
INTERNAL_API_URL="http://localhost:3001"

# --- Escalation SMS (Twilio) --------------------------------------------------
# Provider switch (only "twilio" is implemented at this stage).
SMS_PROVIDER=twilio

# From the Twilio console: Account Info → Account SID + Auth Token.
#
# SECRET ORDER TWILIO_AUTH_TOKEN: NEVER COMMIT. It can be used to send SMS
# billed to your account and to read your usage metadata. Rotate immediately
# if found in a commit (console → Auth Tokens → new + invalidate old), and
# rotate it as policy every 90 days. The pre-commit secret scan
# (backend/.husky/pre-commit) blocks it.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Where the escalation SMS goes — exactly ONE on-call warden number,
# E.164 format (e.g. +919876543210). On a trial account this number must be
# verified in the Twilio console first (Console → Phone Numbers → Manage →
# Verified Caller IDs), or Twilio rejects the send with error 21608.
# Not a secret, but never commit a real number: update it when the on-call
# roster changes instead.
WARDEN_ONCALL_PHONE=""

# =============================================================================
# MONITORING (hardening stage)
# =============================================================================
# Shared secret required by GET /metrics (?token=...) on every API instance
# and by the worker's /metrics server. MUST equal the token under
# `params: token:` for every scrape job in monitoring/prometheus.yml.
# NEVER COMMIT a real token. Rotate whenever it may have leaked (it appears
# in the monitoring compose config and in screenshots!).
METRICS_TOKEN="demo-metrics-token-CHANGE-ME"

# Port the ESCALATION WORKER process exposes its own Prometheus registry on.
# Distinct from the API ports (3001-3003). Prometheus scrapes it as
# host.docker.internal:<this port> under job "worker".
WORKER_METRICS_PORT=4001

# pino log level for every process (api + worker). Default: info.
# debug in dev when chasing a bug; NEVER "silent" in production — the
# break-glass override and EscalationFailuresHigh trails depend on warn/error
# reaching stdout.
LOG_LEVEL=info

# Rate limiting master switch. All three limiters (SOS 5/60s per student,
# login 10/15min per IP, global 100/60s per IP) evaluate this PER REQUEST.
# Default/production: leave unset or anything except '0' (= enabled).
# Only tests set RATE_LIMIT_ENABLED=0 (see tests/helpers/testEnv.ts).
# RATE_LIMIT_ENABLED=1

# =============================================================================
# SECURITY NOTES — READ BEFORE DEPLOYING ANYTHING
# =============================================================================
# 1. Every secret above is loaded from backend/.env, which is gitignored.
#    Verify with the pre-commit hook (docs/SECURITY.md) — it scans STAGED
#    files for Twilio/JWT/PEM-shaped strings.
# 2. Rotation cadence: TWILIO_AUTH_TOKEN and METRICS_TOKEN every 90 days or
#    immediately on suspicion; JWT_SECRET on confirmed leakage — invalidating
#    it logs out every warden (they simply re-login).
# 3. FIREBASE_SERVICE_ACCOUNT_B64 is a full service-account credential:
#    scope the service account to Firebase Cloud Messaging ONLY in the
#    console, never commit the base64 string.
# 4. The demo JWT lifetime is 7d (docs/SECURITY.md explains the trade-off
#    and the "refresh token" next step for production).
