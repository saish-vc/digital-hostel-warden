# =============================================================================
# HostelGuard Backend — Production Environment Template (.env.production)
# =============================================================================
# Copy this file to .env on your production host (or populate via CI/CD secrets).
# NEVER commit real credentials to version control.
# =============================================================================

# Database (PostgreSQL with PgBouncer transaction pooling)
# DATABASE_URL: pooled proxy endpoint for application queries
DATABASE_URL="postgresql://hostelguard_user:SECURE_PASSWORD@db-pooler.your-cloud.internal:5432/hostel_prod?sslmode=require&pgbouncer=true&connection_limit=5"
# DIRECT_DATABASE_URL: non-pooled direct endpoint used ONLY for migrations (DDL/locks)
DIRECT_DATABASE_URL="postgresql://hostelguard_user:SECURE_PASSWORD@db-direct.your-cloud.internal:5432/hostel_prod?sslmode=require"

# JWT Authentication
JWT_SECRET="CHANGE-ME-production-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server & Network Ports
PORT=3001
CORS_ORIGIN="https://dashboard.hostelguard.com,https://admin.hostelguard.com"
ENABLE_HTTPS_REDIRECT=true

# Redis (ElastiCache / Upstash / Managed Redis 7+)
# Must have maxmemory-policy=noeviction and AOF appendfsync=everysec
REDIS_URL="rediss://:REDIS_AUTH_TOKEN@redis.your-cloud.internal:6379"

# Notification Services (Firebase Cloud Messaging)
# Base64-encoded Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_B64=""
DASHBOARD_URL="https://dashboard.hostelguard.com"

# Escalation & SMS (Twilio / Production SMS Provider)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
WARDEN_ONCALL_PHONE=""
ESCALATION_DELAY_MS=60000
INTERNAL_API_URL="http://127.0.0.1:3001"

# Observability & Monitoring
METRICS_TOKEN="CHANGE-ME-production-metrics-token"
WORKER_METRICS_PORT=4001
LOG_LEVEL="info"
RATE_LIMIT_ENABLED=1
