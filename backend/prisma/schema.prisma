generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL used by the app (PgBouncer / Neon pooler / Railway).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) URL used ONLY by prisma migrate / introspect.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-Tenancy Hierarchy (Organization -> Campus -> Block)
// ---------------------------------------------------------------------------

model Organization {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  plan      String           @default("standard")
  createdAt DateTime         @default(now())
  campuses  Campus[]
  alerts    EmergencyAlert[]
}

model Campus {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  blocks         Block[]
  createdAt      DateTime     @default(now())

  @@index([organizationId], map: "idx_campus_organization")
}

model Block {
  id        String    @id @default(uuid())
  campusId  String
  campus    Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  students  Student[]
  wardens   Warden[]
  createdAt DateTime  @default(now())

  @@index([campusId], map: "idx_block_campus")
}

// ---------------------------------------------------------------------------
// Core Users & Emergency System
// ---------------------------------------------------------------------------

model Student {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  passwordHash      String
  roomNumber        String
  emergencyContact  String
  medicalConditions String?
  blockId           String?
  block             Block?           @relation(fields: [blockId], references: [id])
  alerts            EmergencyAlert[]
  leaveRequests     LeaveRequest[]

  @@index([blockId], map: "idx_students_block")
}

model Warden {
  id                 String           @id @default(uuid())
  name               String
  email              String           @unique
  passwordHash       String
  hostelBlock        String
  blockId            String?
  block              Block?           @relation(fields: [blockId], references: [id])
  acknowledgedAlerts EmergencyAlert[]
  deviceTokens       DeviceToken[]
  reviewedLeaves     LeaveRequest[]   @relation("leaveReviewer")

  @@index([blockId], map: "idx_wardens_block")
}

/// One row per browser/device that a warden has granted notification
/// permission from. The token is FCM's registration token.
model DeviceToken {
  id         Int      @id @default(autoincrement())
  wardenId   String
  warden     Warden   @relation(fields: [wardenId], references: [id], onDelete: Cascade)
  token      String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([wardenId], map: "idx_device_tokens_warden")
}

model EmergencyAlert {
  id                   String        @id @default(uuid())
  studentId            String
  student              Student       @relation(fields: [studentId], references: [id])
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id])
  type                 String

  // Full alert lifecycle: PENDING -> ACKNOWLEDGED -> RESOLVED
  status               String    @default("PENDING")
  latitude             Float?
  longitude            Float?
  locationAccuracy     Float?
  createdAt            DateTime  @default(now())
  acknowledgedAt       DateTime?
  acknowledgedBy       String?
  acknowledgedByWarden Warden?   @relation(fields: [acknowledgedBy], references: [id])
  resolvedAt           DateTime?
  resolutionNote       String?

  @@index([status, createdAt(sort: Desc)], map: "idx_alerts_status_created")
  @@index([studentId], map: "idx_alerts_student")
  @@index([organizationId], map: "idx_alerts_org")
}

// ---------------------------------------------------------------------------
// Leave Management System (Hostel In/Out & Gate Pass)
// ---------------------------------------------------------------------------

model LeaveRequest {
  id                String       @id @default(uuid())
  studentId         String
  student           Student      @relation(fields: [studentId], references: [id])
  type              String       // "DAY_OUTING" | "NIGHT_OUT" | "HOME_VISIT" | "MEDICAL"
  reason            String
  destination       String
  emergencyContact  String
  departureTime     DateTime
  expectedReturn    DateTime
  actualDeparture   DateTime?
  actualReturn      DateTime?
  status            String       @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | DEPARTED | RETURNED | OVERDUE | CANCELLED
  parentConsent     Boolean      @default(false)
  parentContactedAt DateTime?
  gatePassCode      String?      @unique
  gatePassQr        String?
  departedGateBy    String?
  returnedGateBy    String?
  reviewedBy        String?
  reviewer          Warden?      @relation("leaveReviewer", fields: [reviewedBy], references: [id])
  reviewedAt        DateTime?
  reviewRemarks     String?
  overdueNotifiedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([studentId, status], map: "idx_leave_student_status")
  @@index([status, departureTime], map: "idx_leave_status_departure")
  @@index([status, expectedReturn], map: "idx_leave_overdue")
}
