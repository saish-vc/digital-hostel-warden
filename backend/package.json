{
  "name": "hostel-emergency-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1 MVP backend for the Hostel Emergency Monitoring System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/workers/escalation.worker.ts",
    "worker:dev": "tsx watch src/workers/escalation.worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:multi-instance": "vitest run tests/multi-instance.test.ts",
    "demo:reset": "tsx prisma/demo-reset.ts",
    "test:demo": "vitest run tests/demo.test.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "3.0.2",
    "bullmq": "6.7.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.2",
    "socket.io": "4.8.1",
    "twilio": "6.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "prisma": "6.7.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.7.0": true,
    "@prisma/engines@6.7.0": true,
    "prisma@6.7.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "msgpackr-extract@3.0.7": true
  }
}
