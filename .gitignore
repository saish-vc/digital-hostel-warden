# Repository-root ignores. Each sub-project has its own .gitignore; this one
# exists so a stray root-level artifact can never be committed.
node_modules/
dist/
build/
coverage/

# Secrets: every real .env is local. Only the templates are committed.
.env
.env.*
!.env.example
!.env.test.example
!.env.production.example
firebase-service-account.json
# Firebase Android config: not a server credential, but it embeds a Google API
# key and the pre-commit scan flags that shape. Keep it local per checkout.
google-services.json
*.pem
*.p12

*.log

# Project-local k6 binary for load-test/sos.js (downloaded, not committed).
.k6/

# Cloudflare tunnel: credentials JSON + config live in ~/.cloudflared/; never
# commit a copy. .tools/ holds the downloaded cloudflared binary.
.cloudflared/
.tools/
